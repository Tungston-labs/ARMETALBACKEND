###############################################################
### Subscription Plan APIs
###############################################################

###############################################################
### Create Basic Plan
###############################################################

POST {{baseUrl}}/plans/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Basic Plan",
    "plan_type": "basic",
    "description": "Suitable for small businesses",
    "feature_ids": [1],
    "base_price": "2000.00",
    "extra_employee_price": "100.00",
    "is_active": true
}

###

###############################################################
### Create Enterprise Plan
###############################################################

POST {{baseUrl}}/plans/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Enterprise Plan",
    "plan_type": "enterprise",
    "description": "Suitable for medium and large businesses",
    "feature_ids": [1,2],
    "base_price": "5000.00",
    "extra_employee_price": "75.00",
    "is_active": true
}

