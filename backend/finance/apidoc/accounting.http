### =====================================================
### LIST ALL ACCOUNTS
### =====================================================

GET {{baseUrl}}accounting/
Authorization: Bearer {{token}}


### =====================================================
### SEARCH BY ACCOUNT NAME
### =====================================================

GET {{baseUrl}}accounting/?search=bank
Authorization: Bearer {{token}}


### =====================================================
### SEARCH BY ACCOUNT CODE
### =====================================================

GET {{baseUrl}}accounting/?search=1200
Authorization: Bearer {{token}}


### =====================================================
### FILTER BY ACCOUNT TYPE - ASSET
### =====================================================

GET {{baseUrl}}accounting/?account_type=asset
Authorization: Bearer {{token}}


### =====================================================
### FILTER BY ACCOUNT TYPE - LIABILITY
### =====================================================

GET {{baseUrl}}accounting/?account_type=liability
Authorization: Bearer {{token}}


### =====================================================
### FILTER BY ACCOUNT TYPE - EQUITY
### =====================================================

GET {{baseUrl}}accounting/?account_type=equity
Authorization: Bearer {{token}}


### =====================================================
### FILTER BY ACCOUNT TYPE - REVENUE
### =====================================================

GET {{baseUrl}}accounting/?account_type=revenue
Authorization: Bearer {{token}}


### =====================================================
### FILTER BY ACCOUNT TYPE - EXPENSE
### =====================================================

GET {{baseUrl}}accounting/?account_type=expense
Authorization: Bearer {{token}}


### =====================================================
### FILTER ACTIVE ACCOUNTS
### =====================================================

GET {{baseUrl}}accounting/?status=active
Authorization: Bearer {{token}}


### =====================================================
### FILTER INACTIVE ACCOUNTS
### =====================================================

GET {{baseUrl}}accounting/?status=inactive
Authorization: Bearer {{token}}


### =====================================================
### COMBINED FILTER
### Asset + Active + Search
### =====================================================

GET {{baseUrl}}accounting/?account_type=asset&status=active&search=bank
Authorization: Bearer {{token}}


### =====================================================
### CHART OF ACCOUNTS - KPI
### =====================================================

GET {{baseUrl}}accounting/kpi/
Authorization: Bearer {{token}}


### edit chart of acounts
PATCH  {{baseUrl}}accounting/1/
Authorization:Bearer {{token}}
Content-Type: application/json

{
  "account_name": "Office Equipment",
  "description": "Office equipment and furniture"
}

### delete account

DELETE {{baseUrl}}accounting/9/
Authorization:Bearer {{token}}
