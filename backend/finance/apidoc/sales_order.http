Authorization: Bearer {{token}}
Content-Type: application/json

{
    "order_status": "confirmed"
}


###########################################################
# 39. UPDATE TO PROCESSING
###########################################################

PATCH {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "order_status": "processing"
}


###########################################################
# 40. UPDATE DELIVERY DATE
###########################################################

PATCH {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "delivery_date": "2026-09-20"
}


###########################################################
# 41. UPDATE DUE DATE
###########################################################

PATCH {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "due_date": "2026-09-25"
}


###########################################################
# 42. UPDATE PAYMENT TERMS
###########################################################

PATCH {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "payment_terms": "net_30"
}


###########################################################
# 43. UPDATE WAREHOUSE
###########################################################

PATCH {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "warehouse": 4
}


###########################################################
# 44. UPDATE DISCOUNT
###########################################################

PATCH {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "discount": "100.00"
}


