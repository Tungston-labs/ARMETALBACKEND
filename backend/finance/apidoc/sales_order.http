# 45. UPDATE ROUND OFF
###########################################################

PATCH {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "round_off": "-0.50"
}


###########################################################
# 46. UPDATE NOTES
###########################################################

PATCH {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "notes": "Customer requested delivery before 20 September"
}


###########################################################
# 47. UPDATE COMPLETE SALES ORDER
###########################################################

PUT {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "quotation": 5,
    "company": 1,
    "customer": 12,
    "warehouse": 3,
    "order_date": "2026-09-07",
    "delivery_date": "2026-09-20",
    "due_date": "2026-09-25",
    "payment_terms": "net_15",
    "order_status": "confirmed",
    "discount": "50.00",
    "round_off": "0.00",
    "notes": "Updated complete Sales Order"
}


###########################################################
# 48. UPDATE ITEMS
#
# Sending items replaces the existing Sales Order items.
###########################################################

PUT {{baseUrl}}/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "quotation": 5,
    "company": 1,
    "customer": 12,
    "warehouse": 3,
    "order_date": "2026-09-07",
    "delivery_date": "2026-09-20",
    "due_date": "2026-09-25",
    "payment_terms": "net_15",
    "order_status": "confirmed",
    "discount": "50.00",
    "round_off": "0.00",
    "notes": "Updated items",

    "items": [
        {
            "quotation_item": 10,
            "product": 4,
            "service_name": "Product A",
            "description": "Updated Product A",
            "quantity": "10.00",
            "delivered_quantity": "0.00",
            "hs_code": "1234",
            "rate": "500.00",
            "vat_percentage": "15.00"
        }
    ]
}


###########################################################
# 49. DELETE SALES ORDER
###########################################################

DELETE {{baseUrl}}/1/
Authorization: Bearer {{token}}


###########################################################
# DELIVERY TEST DATA
###########################################################

# NOTE:
# Currently delivered_quantity is part of SalesOrderItem.
#
# When you implement the delivery API, you can use:
#
# PATCH /api/finance/sales-order/1/items/1/delivery/
#
# with:
#
# {
#     "delivered_quantity": "5.00"
# }
#
# Then:
#
# 0 / 10  -> pending
# 5 / 10  -> partially_delivered
# 10 / 10 -> completed
###########################################################

###customer detail sales order
GET {{baseUrl}}/customer/1/orders/
Authorization: Bearer {{token}}

###customer details order -summary card

GET {{baseUrl}}/customer/5/orders/summary/
Authorization: Bearer {{token}}


