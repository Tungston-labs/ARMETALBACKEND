    "bill_to_phone": "+971502222222",
    "finance_contact_email": "finance@customer.com",

    "discount": "150.00",
    "round_off": "0.00",

    "negotiation_amount": "100.00",

    "notes": "Updated quotation details.",

    "items": [
        {
            "product": {{product_id_1}},
            "service_name": "Updated Website Development",
            "description": "Updated website development package",
            "quantity": "3",
            "hs_code": "998314",
            "rate": "600.00",
            "vat_percentage": "15.00"
        },
        {
            "product": {{product_id_2}},
            "service_name": "Updated Hosting",
            "description": "Updated hosting package",
            "quantity": "1",
            "hs_code": "998315",
            "rate": "300.00",
            "vat_percentage": "15.00"
        }
    ]
}


