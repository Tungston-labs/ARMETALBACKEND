########################################################

# INVOICE API

# FLOW:

# Quotation -> Sales Order -> Invoice

########################################################

########################################################

# 1. GET SALES ORDERS AVAILABLE FOR INVOICE

########################################################

### Get Sales Orders Available For Invoice

GET {{base_url}}/api/finance/invoice/sales-orders/
Authorization: Bearer {{access_token}}

########################################################

# 2. GET SALES ORDER DETAILS

########################################################

### Get Sales Order Details For Invoice

GET {{base_url}}/api/finance/invoice/sales-orders/{{sales_order_id}}/
Authorization: Bearer {{access_token}}

########################################################

# 3. CREATE INVOICE FROM SALES ORDER

########################################################

### Create Invoice From Sales Order

POST {{base_url}}/api/finance/invoice/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
"sales_order": 1,
"invoice_date": "2026-09-17",
"due_date": "2026-10-02",
"account_holder": "ABC Bank",
"account_number": "1234567890",
"iban": "AE123456789012345678901",
"amount_paid": "0.00"
}

########################################################

# 4. CREATE PAID INVOICE FROM SALES ORDER

########################################################

### Create Paid Invoice

POST {{base_url}}/api/finance/invoice/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
"sales_order": 2,
"invoice_date": "2026-09-21",
"due_date": "2026-09-21",
"account_holder": "ABC Bank",
"account_number": "1234567890",
"iban": "AE123456789012345678901",
"amount_paid": "1330.00"
}

########################################################

# 5. CREATE PARTIALLY PAID INVOICE FROM SALES ORDER

########################################################

### Create Partially Paid Invoice

POST {{base_url}}/api/finance/invoice/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
"sales_order": 3,
"invoice_date": "2026-09-17",
"due_date": "2026-10-17",
"account_holder": "ABC Bank",
"account_number": "1234567890",
"iban": "AE123456789012345678901",
"amount_paid": "500.00"
}

########################################################

# 6. CREATE INVOICE WITH NO PAYMENT

########################################################

### Explicitly Create Unpaid Invoice

POST {{base_url}}/api/finance/invoice/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
"sales_order": 4,
"invoice_date": "2026-09-17",
"due_date": "2026-10-17",
"amount_paid": "0.00"
}

########################################################

# NOTE ABOUT CREATE INVOICE

########################################################

# DO NOT SEND:

#

# "customer"

# "company"

# "items"

#

# These are automatically taken from the Sales Order.

#

# Example:

#

# Sales Order

# |

# +-- Company

# +-- Customer

# +-- Warehouse

# +-- Discount

# +-- Round Off

# |

# +-- Sales Order Items

# +-- Product

# +-- Quantity

# +-- Rate

# +-- VAT

# +-- HS Code

#

# Invoice is created using this information.

########################################################

# 7. LIST INVOICES

########################################################

### List All Invoices

GET {{base_url}}/api/finance/invoice/

Authorization: Bearer {{access_token}}

########################################################

# 8. SEARCH INVOICES

########################################################

### Search By Invoice Number

GET {{base_url}}/api/finance/invoice/?search=INV002

Authorization: Bearer {{access_token}}

### Search By Customer Name

GET {{base_url}}/api/finance/invoice/?search=ABC

Authorization: Bearer {{access_token}}

### Search By Sales Order Number

GET {{base_url}}/api/finance/invoice/?search=SO-0001

Authorization: Bearer {{access_token}}

########################################################

# 9. FILTER BY PAYMENT STATUS

########################################################

### Paid Invoices

GET {{base_url}}/api/finance/invoice/?payment_status=paid

Authorization: Bearer {{access_token}}

### Unpaid Invoices

GET {{base_url}}/api/finance/invoice/?payment_status=unpaid

Authorization: Bearer {{access_token}}

### Partially Paid Invoices

GET {{base_url}}/api/finance/invoice/?payment_status=partially_paid

Authorization: Bearer {{access_token}}

########################################################

# 10. FILTER BY CUSTOMER

########################################################

### Customer Invoices

GET {{base_url}}/api/finance/invoice/?customer={{customer_id}}

Authorization: Bearer {{access_token}}

########################################################

# 11. FILTER BY SALES ORDER

########################################################

### Invoice For Sales Order

GET {{base_url}}/api/finance/invoice/?sales_order={{sales_order_id}}

Authorization: Bearer {{access_token}}

########################################################

# 12. FILTER BY DUE DATE

########################################################

### Exact Due Date

GET {{base_url}}/api/finance/invoice/?due_date=2026-09-30

Authorization: Bearer {{access_token}}

### Due Date From

GET {{base_url}}/api/finance/invoice/?due_date_after=2026-09-01

Authorization: Bearer {{access_token}}

### Due Date Until

GET {{base_url}}/api/finance/invoice/?due_date_before=2026-09-30

Authorization: Bearer {{access_token}}

### Due Date Range

GET {{base_url}}/api/finance/invoice/?due_date_after=2026-09-01&due_date_before=2026-09-30

Authorization: Bearer {{access_token}}

########################################################

# 13. COMBINED FILTERS

########################################################

### Search + Status

GET {{base_url}}/api/finance/invoice/?search=ABC&payment_status=unpaid

Authorization: Bearer {{access_token}}

### Customer + Status

GET {{base_url}}/api/finance/invoice/?customer={{customer_id}}&payment_status=paid

Authorization: Bearer {{access_token}}

### Sales Order + Status

GET {{base_url}}/api/finance/invoice/?sales_order={{sales_order_id}}&payment_status=unpaid

Authorization: Bearer {{access_token}}

### Status + Due Date

GET {{base_url}}/api/finance/invoice/?payment_status=unpaid&due_date_before=2026-09-30

Authorization: Bearer {{access_token}}

### Search + Customer + Status + Due Date

GET {{base_url}}/api/finance/invoice/?search=ABC&customer={{customer_id}}&payment_status=unpaid&due_date_before=2026-09-30

Authorization: Bearer {{access_token}}

### Search + Sales Order + Status

GET {{base_url}}/api/finance/invoice/?search=SO-0001&payment_status=unpaid

Authorization: Bearer {{access_token}}

########################################################

# 14. SORTING

########################################################

### Latest Created

GET {{base_url}}/api/finance/invoice/?ordering=-created_at

Authorization: Bearer {{access_token}}

### Oldest Created

GET {{base_url}}/api/finance/invoice/?ordering=created_at

Authorization: Bearer {{access_token}}

### Latest Invoice Date

GET {{base_url}}/api/finance/invoice/?ordering=-invoice_date

Authorization: Bearer {{access_token}}

### Oldest Invoice Date

GET {{base_url}}/api/finance/invoice/?ordering=invoice_date

Authorization: Bearer {{access_token}}

### Lowest Total Amount

GET {{base_url}}/api/finance/invoice/?ordering=total_amount

Authorization: Bearer {{access_token}}

### Highest Total Amount

GET {{base_url}}/api/finance/invoice/?ordering=-total_amount

Authorization: Bearer {{access_token}}

### Lowest Paid Amount

GET {{base_url}}/api/finance/invoice/?ordering=amount_paid

Authorization: Bearer {{access_token}}

### Highest Paid Amount

GET {{base_url}}/api/finance/invoice/?ordering=-amount_paid

Authorization: Bearer {{access_token}}

### Sort By Sales Order

GET {{base_url}}/api/finance/invoice/?ordering=sales_order__so_number

Authorization: Bearer {{access_token}}

### Reverse Sales Order

GET {{base_url}}/api/finance/invoice/?ordering=-sales_order__so_number

Authorization: Bearer {{access_token}}

########################################################

# 15. RETRIEVE INVOICE

########################################################

### Invoice Detail

GET {{base_url}}/api/finance/invoice/{{invoice_id}}/

Authorization: Bearer {{access_token}}

########################################################

# 16. UPDATE INVOICE

########################################################

### Update Invoice

PUT {{base_url}}/api/finance/invoice/{{invoice_id}}/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
"invoice_date": "2026-09-17",
"due_date": "2026-11-17",
"account_holder": "Updated Bank",
"account_number": "9876543210",
"iban": "AE987654321098765432109",
"amount_paid": "1000.00"
}

########################################################

# IMPORTANT:

# DO NOT CHANGE SALES ORDER DURING UPDATE

########################################################

# Do NOT send:

#

# "sales_order"

# "customer"

# "company"

# "items"

#

# The Invoice remains linked to the original Sales Order.

########################################################

