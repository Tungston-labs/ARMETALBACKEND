########################################################

### Sales Order Invoice Summary

GET {{base_url}}/api/finance/invoice/summary/?sales_order={{sales_order_id}}

Authorization: Bearer {{access_token}}

########################################################

# EXPECTED FLOW

########################################################

# STEP 1

# GET /api/finance/invoice/sales-orders/

#

# Select a Sales Order.

# STEP 2

# GET /api/finance/invoice/sales-orders/{sales_order_id}/

#

# Display Sales Order details and items.

# STEP 3

# POST /api/finance/invoice/

#

# {

# "sales_order": 1,

# "invoice_date": "2026-09-17",

# "due_date": "2026-10-02",

# "amount_paid": "0.00"

# }

# STEP 4

# Backend creates:

#

# INV001

#

# using:

#

# SO-0001

#

# Company       <- Sales Order

# Customer      <- Sales Order

# Items         <- Sales Order Items

# Product       <- Sales Order Items

# Quantity      <- Sales Order Items

# Rate          <- Sales Order Items

# VAT           <- Sales Order Items

# HS Code       <- Sales Order Items

# Discount      <- Sales Order

# Round Off     <- Sales Order

# STEP 5

# Invoice can then be:

#

# unpaid

# partially_paid

# paid

#

# depending on amount_paid.

########################################################

# PAYMENT STATUS LOGIC

########################################################

# amount_paid = 0

# -> unpaid

#

# amount_paid < total_amount

# -> partially_paid

#

# amount_paid = total_amount

# -> paid

########################################################

# IMPORTANT SALES ORDER RULE

########################################################

# Recommended:

#

# One Sales Order -> One Invoice

#

# Example:

#

# SO-0001 -> INV001

#

# Trying to create another invoice from SO-0001

# should return an error:

#

# "An invoice already exists for this sales order."

########################################################

# END OF INVOICE API TESTS

########################################################
