########################################################
# 1. CREATE UNPAID INVOICE
########################################################

### Create Invoice
POST {{base_url}}/api/finance/invoice/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "customer": 1,
    "invoice_date": "2026-09-17",
    "due_date": "2026-10-17",
    "discount": "100.00",
    "round_off": "0.00",
    "account_holder": "ABC Bank",
    "account_number": "1234567890",
    "iban": "AE123456789012345678901",
    "items": [
        {
            "product": 1,
            "particular": "Website Development",
            "quantity": "2",
            "hs_code": "998314",
            "rate": "500.00",
            "vat_percentage": "5.00"
        },
        {
            "product": 2,
            "particular": "Hosting Service",
            "quantity": "1",
            "hs_code": "998315",
            "rate": "200.00",
            "vat_percentage": "5.00"
        }
    ]
}


########################################################
# 2. CREATE PAID INVOICE
########################################################

### Create Paid Invoice
POST {{base_url}}/api/finance/invoice/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "customer": 1,
    "invoice_date": "2026-09-17",
    "due_date": "2026-09-17",
    "discount": "0.00",
    "round_off": "0.00",
    "amount_paid": "575.00",
    "account_holder": "ABC Bank",
    "account_number": "1234567890",
    "iban": "AE123456789012345678901",
    "items": [
        {
            "product": 1,
            "particular": "Product Purchase",
            "quantity": "5",
            "hs_code": "123456",
            "rate": "100.00",
            "vat_percentage": "15.00"
        }
    ]
}


