########################################################

### Update Amount Paid

PATCH {{base_url}}/api/finance/invoice/{{invoice_id}}/

Authorization: Bearer {{access_token}}
Content-Type: application/json

{
"amount_paid": "500.00"
}

########################################################

# 18. PARTIAL UPDATE - SET UNPAID

########################################################

### Set Payment Amount To Zero

PATCH {{base_url}}/api/finance/invoice/{{invoice_id}}/

Authorization: Bearer {{access_token}}
Content-Type: application/json

{
"amount_paid": "0.00"
}

########################################################

# 19. PARTIAL UPDATE - FULL PAYMENT

########################################################

### Set Invoice As Fully Paid

PATCH {{base_url}}/api/finance/invoice/{{invoice_id}}/

Authorization: Bearer {{access_token}}
Content-Type: application/json

{
"amount_paid": "1330.00"
}

